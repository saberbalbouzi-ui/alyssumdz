# تشغيل اختبارات/أدوات Beta محلياً. انسخ هذا الملف إلى مسار **خارج المستودع** (مثلاً ~/.alyssum/beta.env) وعبّئه بنفسك ثم: set -a; . ~/.alyssum/beta.env; set +a
# لا تضع قيماً حقيقية هنا (الملف مُسجَّل في المستودع). الأسرار تُدخَل في GitHub Secrets (البيئة alyssumdz-beta) أو لوحة المزوّد — لا في المحادثة ولا في الشيفرة.
# مولَّد من platform/env/beta-resources.json بـ node platform/env/gen-beta-env.mjs

# ── متغيرات (غير سرّية) ──
# معرّف حساب Cloudflare الخاص بـBeta
BETA_CF_ACCOUNT_ID=<value>
# اسم قاعدة D1 (يجب = alyssum-platform-api-beta)
BETA_D1_NAME=<value>
# عنوان منصة Beta بعد النشر (https://alyssum-platform-api-beta.contact-alyssumbio.workers.dev)
BETA_API_URL=<value>
# https://<beta-ref>.supabase.co
BETA_SUPABASE_URL=<value>
# مرجع مشروع Beta (يُقارَن بالرابط والسجل)
BETA_SUPABASE_REF=<value>
# المفتاح العام (publishable/anon) — يصل المتصفح بطبيعته
BETA_SUPABASE_ANON_KEY=<public-value>
# بريد مدير Beta (D3؛ ≠ بريد المالك)
BETA_ADMIN_EMAIL=<value>

# ── أسرار (تُدخَل في GitHub Secrets/محلياً خارج المستودع) ──
# رمز اختبار D1 البعيد (صلاحية D1:Edit فقط)
BETA_CF_API_TOKEN=<secret-enter-outside-repo>
# Personal Access Token لاستعلامات إدارة قاعدة Beta (فحص RLS/Storage). يُنشأ بحساب/منظمة لا تملك مشروع Production إن أمكن
BETA_SUPABASE_PAT=<secret-enter-outside-repo>
# كلمة مرور مدير Beta (اختبار Auth)
BETA_ADMIN_PASSWORD=<secret-enter-outside-repo>
# ADMIN_TOKEN الخاص بمنصة Beta (يولّده deploy.mjs secrets؛ يُنسخ من الملف خارج المستودع)
BETA_API_ADMIN_TOKEN=<secret-enter-outside-repo>
# مفتاح Chargily التجريبي test_sk_… حصراً
BETA_CHARGILY_TEST_SECRET_KEY=<secret-enter-outside-repo>

# ── لأدوات النشر المحلية فقط (رمز النشر لا يُوضع في GitHub) ──
CF_API_TOKEN=<beta-deploy-token>
CF_ACCOUNT_ID=<same-as-BETA_CF_ACCOUNT_ID>
CF_ZONE_ID=<beta-zone-id>

