# تطوير محلي (ENVIRONMENT=local): قيم وهمية فقط — لا تضع هنا مفاتيح حقيقية (هذا الملف مُسجَّل في المستودع)
ENVIRONMENT=local
PUBLIC_URL=http://localhost:8787
PLATFORM_SECRET=local-dev-platform-secret-0123456789
ADMIN_TOKEN=local-dev-admin-token-0123456789abcdef
# APP_ENCRYPTION_KEY=<base64 من 32 بايت يولَّد محلياً: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
CHARGILY_MODE=test
# الخروج: لا اتصال خارجي افتراضياً في local (إلا localhost)؛ لإضافة مضيف تجريبي: EGRESS_ALLOW_EXTRA=sandbox.example.test
