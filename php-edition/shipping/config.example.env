# انسخه إلى مكان خارج الجذر العام (مثلاً /etc/alyssum/shipping.env) واضبط SHIPPING_ENV_FILE إليه. لا تضعه في المستودع.
# ولّد المفتاح:  php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_ENCRYPTION_KEY=
# تدوير المفاتيح (اختياري): APP_ENCRYPTION_KEYS={"k1":"<b64>","k2":"<b64>"} و APP_ENCRYPTION_KID=k2 ثم شغّل ConnectionRepository::rotate()
SHIPPING_DB_DSN=sqlite:/var/lib/alyssum/shipping.sqlite
SHIPPING_DB_USER=
SHIPPING_DB_PASS=
